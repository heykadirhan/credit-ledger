PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_DB=credit_ledger
WEBHOOK_SECRET=change-me
# Creates a "Demo" account with this API key and 100 credits on startup.
DEMO_API_KEY=demo-key
# Enables POST /dev/fake-provider/pay/:orderId, which plays the payment provider.
FAKE_PROVIDER=true
# Share of jobs the fake render engine fails on purpose, so refunds show up.
FAKE_FAILURE_RATE=0.25
